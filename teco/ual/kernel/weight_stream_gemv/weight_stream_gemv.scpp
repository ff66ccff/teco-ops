// weight_stream_gemv: M=1 decode GEMV organised around streaming the weight
// matrix, not around a tiled GEMM.
//
// Structure (one core of 32, rows split as contiguous blocks by R1C32_CR):
//   * the activation row x[K] is fetched once and converted to fp32 in SPM - it
//     is reused by every weight row this core owns;
//   * the weight matrix is consumed as CONTIGUOUS slabs of `slab` whole rows
//     (slab*K*2 bytes), double buffered, so each DMA is one large burst and the
//     core never waits on a small strided transfer;
//   * each weight row is reduced against x with a 16-wide fp32 FMA chain plus one
//     horizontal reduce, then stored into a per-core SPM output buffer and
//     flushed with a single DMA at the end.
//
// Numerics: fp16 operands, fp32 accumulation, single fp16 rounding of the result
// - the same skeleton as the vendor GEMM, but with this kernel's own reduction
// order.  That ordering difference is exactly what the model-level token-ID
// parity gate measures.

#include <simd.h>
#include <slave.h>

#include "ual/com/rt.h"
#include "ual/kernel/weight_stream_gemv/weight_stream_gemv.h"

#include "teco_hal_tensor.hpp"
#include "teco_hal_tile.hpp"

using namespace tecoops::ual::args;  // NOLINT
using namespace teco::hal;            // NOLINT
using namespace sdaa;                 // NOLINT

namespace {
// SPM bytes this kernel may own in one core.  The delivered flash_attention
// kernel already holds ~450 KB, so 192 KB is deliberately conservative.
constexpr size_t WSG_SPM_BUDGET = 192 * 1024;
constexpr int WSG_SLAB_MAX = 32;
}  // namespace

__global__ void teco_slave_weight_stream_gemv(WeightStreamGemvArgs args) {
    const int N = args.n;
    const int K = args.k;

    half *x_hbm = static_cast<half *>(const_cast<void *>(args.x));
    half *w_hbm = static_cast<half *>(const_cast<void *>(args.w));
    half *y_hbm = static_cast<half *>(args.y);

    Tensor<half, 2> w_gm(w_hbm, {static_cast<size_t>(N), static_cast<size_t>(K)});
    auto tile = make_tile<SplitMode::R1C32_CR>(
        w_gm, {static_cast<size_t>(N), static_cast<size_t>(K)});
    auto block = tile.compute_core_block_shape();
    const int my_rows = static_cast<int>(block[0]);
    if (my_rows <= 0) return;

    // Row-major element offset of this core's first row: row0 * K.
    const size_t offset = tile.compute_linear_index();
    const int row0 = static_cast<int>(offset / static_cast<size_t>(K));

    const size_t row_bytes = static_cast<size_t>(K) * sizeof(half);
    const size_t y_bytes = static_cast<size_t>(my_rows) * sizeof(half);

    int slab = static_cast<int>((WSG_SPM_BUDGET - 4 * static_cast<size_t>(K) - y_bytes) /
                                (2 * row_bytes));
    if (slab < 1) slab = 1;
    if (slab > WSG_SLAB_MAX) slab = WSG_SLAB_MAX;
    if (slab > my_rows) slab = my_rows;

    const size_t slab_bytes = static_cast<size_t>(slab) * row_bytes;
    // One contiguous SPM block with a single rt_spm_malloc / rt_spm_free, the
    // delivered-kernel pattern (rms_norm, flash_attention).  The CHECK_SPM_OVERFLOW
    // allocator puts a 64 B guard before and after every block, so every carve is
    // 64 B aligned and the whole request is padded.
    //
    // Only 32-byte (float16v16) SPM accesses are used anywhere below: every
    // delivered kernel restricts itself to 32-byte half vectors, so this kernel
    // keeps the activation row in fp16 in SPM and converts both operands in the
    // inner loop.  fp16 -> fp32 is exact, so the arithmetic is unchanged.
    const size_t x_bytes = static_cast<size_t>(K) * sizeof(half);
    const size_t need = x_bytes + 2 * slab_bytes + y_bytes + 256;
    char *spm_base = static_cast<char *>(rt_spm_malloc(need));
    if (spm_base == nullptr) return;

    char *cur = spm_base;
    cur += (64 - (reinterpret_cast<unsigned long>(cur) & 63UL)) & 63UL;
    half *xspm = reinterpret_cast<half *>(cur);
    cur += x_bytes;
    half *wbuf0 = reinterpret_cast<half *>(cur);
    cur += slab_bytes;
    half *wbuf1 = reinterpret_cast<half *>(cur);
    cur += slab_bytes;
    half *yout = reinterpret_cast<half *>(cur);

    half *wbuf[2] = {wbuf0, wbuf1};

    // ---- fetch the activation row once into SPM (fp16, exact) ----
    {
        MemcpyHandle hx;
        memcpy_async(xspm, x_hbm, x_bytes, MemcpyGlobalToSpm, hx);
        memcpy_wait(hx);
    }

    MemcpyHandle get[2];
    const int rows0 = (slab < my_rows) ? slab : my_rows;
    memcpy_async(wbuf[0], w_hbm + offset, static_cast<size_t>(rows0) * row_bytes,
                 MemcpyGlobalToSpm, get[0]);

    for (int s0 = 0; s0 < my_rows; s0 += slab) {
        const int cur = (s0 / slab) & 1;
        const int rows = (my_rows - s0 < slab) ? (my_rows - s0) : slab;

        memcpy_wait(get[cur]);

        // Prefetch the next slab into the other buffer.  That buffer was last
        // read by the previous iteration's (already finished) SIMD work.
        if (s0 + slab < my_rows) {
            const int nrow = (my_rows - s0 - slab < slab) ? (my_rows - s0 - slab) : slab;
            memcpy_async(wbuf[cur ^ 1],
                         w_hbm + offset + static_cast<size_t>(s0 + slab) * K,
                         static_cast<size_t>(nrow) * row_bytes,
                         MemcpyGlobalToSpm, get[cur ^ 1]);
        }

        for (int s = 0; s < rows; ++s) {
            const half *wr = wbuf[cur] + static_cast<size_t>(s) * K;
            floatv16 acc = simd_vcpyfs(0.0f);
            int j = 0;
            for (; j + 16 <= K; j += 16) {
                float16v16 hw;
                float16v16 hx;
                simd_loadu(hw, wr + j);
                simd_loadu(hx, xspm + j);
                acc = simd_vfmas(simd_vfcvths(hx), simd_vfcvths(hw), acc);
            }
            float dot = simd_redsum(acc);
            for (; j < K; ++j) dot += static_cast<float>(wr[j]) * static_cast<float>(xspm[j]);
            yout[s0 + s] = static_cast<half>(dot);
        }
    }

    // One contiguous flush of this core's whole output block.
    MemcpyHandle put;
    memcpy_async(y_hbm + row0, yout, y_bytes, MemcpySpmToGlobal, put);
    memcpy_wait(put);
    memcpy_wait(get[0]);
    memcpy_wait(get[1]);
    rt_spm_free(spm_base);
}
